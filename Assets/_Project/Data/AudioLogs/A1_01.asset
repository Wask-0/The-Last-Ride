  lines:
  - text: "\u041C\u043E\u0439 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u0434\u0440\u0443\u0433... \u041C\u044B \u0437\u0430\u043C\u0435\u0440\u0437\u0430\u0435\u043C."
    duration: 0
  - text: "\u041E\u0442\u0432\u0435\u0437\u0438 \u0418\u0441\u043A\u0440\u0443 \u043D\u0430
      \u0412\u0435\u0440\u0448\u0438\u043D\u0443."
    duration: 0
  - text: "\u041D\u0435 \u0434\u0430\u0439 \u0435\u0439 \u043F\u043E\u0433\u0430\u0441\u043D\u0443\u0442\u044C."
